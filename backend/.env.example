PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# MongoDB Atlas connection string (SRV or Legacy format):
# mongodb+srv://<username>:<password>@<cluster-url>/veltrix_inventory?retryWrites=true&w=majority
MONGO_URI=mongodb+srv://<username>:<password>@<cluster-url>/veltrix_inventory?retryWrites=true&w=majority

# Optional JWT Authentication ("true" enforces login + Admin/Staff RBAC; "false" enables open mode)
AUTH_ENABLED=true
# Generate a strong random secret in production (e.g. openssl rand -hex 48)
JWT_SECRET=replace-with-a-long-random-secret-key
JWT_EXPIRES_IN=7d
